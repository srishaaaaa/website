NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Postgres (Neon / Supabase / any). Leave empty to use the embedded PGlite database in server/data (dev only).
DATABASE_URL=
JWT_SECRET=change-me-to-a-random-string-of-32-plus-characters
# Used by `npm run seed` to create the first owner account
ADMIN_EMAIL=owner@dhanya.test
ADMIN_PASSWORD=ChangeMe123!
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=
# "Sign in with Google": create an OAuth 2.0 Client ID (type: Web application) at console.cloud.google.com → APIs & Services → Credentials,
# add your site (https://your-domain and http://localhost:5173) under Authorised JavaScript origins, then paste the Client ID here.
GOOGLE_CLIENT_ID=
